{
  "name": "@strim/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./prisma": "./src/lib/prisma.ts",
    "./ingest": "./src/modules/ingest.ts",
    "./workers": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file ../../.env --watch src/index.ts",
    "start": "bun --env-file ../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'ok'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@hono/node-server": "1.14.1",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "0.18.4",
    "@hono/zod-validator": "0.4.3",
    "@prisma/client": "6.8.2",
    "@scalar/hono-api-reference": "0.12.6",
    "@strim/db": "workspace:*",
    "@strim/shared": "workspace:*",
    "hono": "4.7.11",
    "ioredis": "6.0.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@strim/tsconfig": "workspace:*",
    "bun-types": "1.2.13",
    "typescript": "5.8.3"
  }
}

# Server Configuration
APP_ENV=development
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=info
REQUEST_TIMEOUT_SECONDS=30
BODY_LIMIT_BYTES=2097152

# Database (PostgreSQL / Neon / Supabase via GORM)
DATABASE_URL=postgresql://strim:strim@localhost:5432/strim
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=15

# Swagger Documentation Auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# Auth & Tokens
JWT_SECRET=change-me-in-production-please-use-32+chars
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Ingestion & Engine Limits
INGEST_MAX_RPS=2000
LOADTEST_MAX_RPS=5000
STRIM_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback

# Optional Storage & Services
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=strim
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=strim
MINIO_SECRET_KEY=strimstrim
MINIO_BUCKET=strim

# Web public settings (Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

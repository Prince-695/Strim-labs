generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
}

enum RunProfile {
  SUSTAINED
  RAMP_UP
  SPIKE
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  ABORTED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  Membership[]
  runsStarted  TestRun[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())

  memberships Membership[]
  projects    Project[]
  testRuns    TestRun[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model Project {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  baseUrl        String?
  targetUrl      String
  defaultMethod  String            @default("GET")
  defaultHeaders Json?
  apiKey         String            @unique @default(cuid())
  apiKeyPrefix   String            @default("strim_live_")
  status         String            @default("PENDING_SDK") // PENDING_SDK, ACTIVE, DEGRADED, INCIDENT
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  testRuns         TestRun[]
  discoveredRoutes DiscoveredRoute[]
  telemetryMetrics TelemetryMetric[]

  @@index([organizationId, createdAt])
}

model DiscoveredRoute {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path          String
  method        String
  isSafe        Boolean  @default(true)
  totalCalls    Int      @default(0)
  errorCalls    Int      @default(0)
  avgDurationMs Float    @default(0)
  p95DurationMs Float    @default(0)
  lastSeenAt    DateTime @default(now())
  firstSeenAt   DateTime @default(now())

  @@unique([projectId, method, path])
  @@index([projectId, lastSeenAt])
}

model TelemetryMetric {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timestamp     DateTime @default(now())
  totalRequests Int      @default(0)
  successCount  Int      @default(0) // 2xx
  warningCount  Int      @default(0) // 4xx
  errorCount    Int      @default(0) // 5xx
  p50Ms         Float    @default(0)
  p95Ms         Float    @default(0)
  p99Ms         Float    @default(0)

  @@index([projectId, timestamp])
}

model TestRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  profile        RunProfile   @default(RAMP_UP)
  status         RunStatus    @default(QUEUED)
  targetUrl      String
  method         String       @default("GET")
  headers        Json?
  body           Json?
  concurrency    Int          @default(50)
  durationSec    Int          @default(30)
  
  // Summary Results
  totalRequests  Int          @default(0)
  avgRps         Float        @default(0)
  peakRps        Float        @default(0)
  p50Ms          Float        @default(0)
  p95Ms          Float        @default(0)
  p99Ms          Float        @default(0)
  errorRate      Float        @default(0)
  statusCodes    Json?        // e.g. { "200": 14200, "429": 412, "500": 8 }
  
  // Automated Breaking Point Diagnosis
  breakingPoint  Json?        // { kneeRps: 850, failureRps: 1120, bottleneck: "RATE_LIMIT_429", verdict: "..." }
  
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  
  samples        TestSample[]

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}

model TestSample {
  id          String   @id @default(cuid())
  testRunId   String
  testRun     TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  rps         Float
  activeVUs   Int
  p50Ms       Float
  p95Ms       Float
  p99Ms       Float
  errorCount  Int
  statusCodes Json

  @@index([testRunId, timestamp])
}

{
  "name": "@strim/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "bun --env-file=../../.env ./node_modules/.bin/prisma migrate dev",
    "push": "bun --env-file=../../.env ./node_modules/.bin/prisma db push",
    "seed": "bun --env-file=../../.env src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'ok'"
  },
  "dependencies": {
    "@prisma/client": "6.8.2"
  },
  "devDependencies": {
    "@strim/tsconfig": "workspace:*",
    "bun-types": "1.2.13",
    "prisma": "6.8.2",
    "typescript": "5.8.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "bun --env-file=../../.env src/seed.ts"
  }
}
